# Replace all three placeholders with independent, randomly generated values before use.
ELN_JWT_SECRET=replace-with-at-least-32-random-bytes-before-starting
ELN_BOOTSTRAP_TOKEN=replace-with-another-random-token-of-at-least-32-bytes
ELN_AUDIT_HMAC_KEY=replace-with-a-third-independent-random-key-of-at-least-32-bytes

# PostgreSQL 16 is required. These URLs are examples for local processes.
IDENTITY_DATABASE_URL=postgresql+psycopg://identity:identity_dev_only@localhost:5432/identity
PROJECTS_DATABASE_URL=postgresql+psycopg://projects:projects_dev_only@localhost:5432/projects
NOTEBOOK_DATABASE_URL=postgresql+psycopg://notebook:notebook_dev_only@localhost:5432/notebook
ACTIVITY_DATABASE_URL=postgresql+psycopg://activity:activity_dev_only@localhost:5432/activity

# Docker Compose uses service DNS names and development-only credentials inside
# its network; these localhost URLs are for local backend processes only.